# Optional. ffmpeg-static supplies a binary by default.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
PORT=3001
HOST=127.0.0.1
# Absolute path recommended if overriding the temporary storage location.
# DATA_DIR=C:/path/to/harmonizer-data
# Set true when deployed behind HTTPS to require encrypted session cookies.
# COOKIE_SECURE=true
# Public frontend origin, needed when a proxy changes the API host/protocol.
# Local development defaults to http://127.0.0.1:5173.
# APP_ORIGIN=https://harmonizer.example.com
